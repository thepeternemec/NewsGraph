# ── Pleiades environment ────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# newsapi.ai (Event Registry) — full-access key
NEWSAPI_API_KEY=

# API
PORT=8787
PLEIADES_API_BASE_URL=http://localhost:8787

# Worker
# Comma-separated pilot beat ids; default: all seed beats
PLEIADES_PILOT_BEATS=
# Dry-run prints packs instead of persisting them (Phase 1 pre-DB mode)
PLEIADES_DRY_RUN=true

# Supabase (the platform: Postgres, Edge Functions, Realtime, Auth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Telegram bot (Phase 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (Phase 3)
DISCORD_WEBHOOK_URL=

# x402 (Phase 4)
X402_NETWORK=base
X402_SETTLEMENT_ADDRESS=

# ACP (Phase 4)
ACP_ACCOUNT_ADDRESS=
ACP_RPC_URL=

# Dedicated v2 cursor secret is recommended; rotates invalidate existing cursors.
# Hosted API falls back to a domain-separated service-role key if omitted.
PLEIADES_CURSOR_SECRET=
# Comma-separated extra browser origins allowed to call the MCP endpoint.
PLEIADES_MCP_ORIGINS=
# Optional actual model-loop verification (not needed for news reads)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
